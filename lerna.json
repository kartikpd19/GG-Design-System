{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.1.0",
  "npmClient": "yarn",
  "packages": ["packages/*"],
  "command": {
    "publish": {
      "ignoreChanges": ["*.md", "*.mdx", "**/*.stories.tsx"],
      "message": "chore(release): publish %s"
    },
    "version": {
      "conventionalCommits": true,
      "allowBranch": "main"
    }
  }
}
